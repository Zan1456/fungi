---
// Zero-JS mobile menu via the native <details>/<summary> disclosure element.
import { useTranslations, type Locale } from '@lib/i18n';
import { navGroups } from '@lib/nav';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<details class="relative md:hidden">
  <summary
    class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-border text-foreground [&::-webkit-details-marker]:hidden"
  >
    <svg viewBox="0 0 20 20" class="h-4 w-4 fill-current">
      <path d="M2 5h16v1.5H2V5zm0 4.25h16v1.5H2v-1.5zM2 13.5h16V15H2v-1.5z"></path>
    </svg>
  </summary>
  <nav class="absolute right-0 z-30 mt-2 max-h-[70vh] w-64 overflow-y-auto rounded-lg border border-border bg-background p-3 shadow-xl">
    {
      navGroups.map((group) => (
        <div class="mb-3 last:mb-0">
          <div class="mb-1 px-1 text-[11px] font-medium uppercase tracking-wide text-muted-2">{t(group.key)}</div>
          {group.items.map((item) => (
            <a
              href={`/${locale}${item.href === '/' ? '' : item.href}`}
              class="block rounded-md px-2 py-1.5 text-sm text-muted hover:bg-white/5 hover:text-foreground"
            >
              {t(item.key)}
            </a>
          ))}
        </div>
      ))
    }
  </nav>
</details>
