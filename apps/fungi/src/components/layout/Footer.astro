---
import { useTranslations, type Locale } from '@lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="border-t border-border">
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-2 px-4 py-8 text-xs text-muted-2 sm:px-6 lg:px-8">
    <p>{t('home.footerNote')}</p>
    <p>
      <a
        href="https://github.com/MadeBaruna/paimon-moe"
        class="underline hover:text-muted"
        target="_blank"
        rel="noreferrer"
      >
        paimon.moe
      </a>
      {locale === 'hu' ? ' adatai alapján, MIT licenc.' : ' data, MIT licensed.'}
    </p>
  </div>
</footer>
