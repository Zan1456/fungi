---
// Root path has no locale; sniff Accept-Language and bounce to /hu or /en (hu is the default).
const acceptLanguage = Astro.request.headers.get('accept-language')?.toLowerCase() ?? '';
const targetLocale = acceptLanguage.startsWith('en') && !acceptLanguage.includes('hu') ? 'en' : 'hu';
return Astro.redirect(`/${targetLocale}`, 302);
