---
export interface Props {
  href?: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class={`group block rounded-lg border border-border bg-surface/60 p-5 transition-colors duration-150 hover:border-border-hover ${className}`}
>
  <slot />
</Tag>
