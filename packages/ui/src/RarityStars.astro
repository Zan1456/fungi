---
export interface Props {
  rarity: number;
  class?: string;
}

const { rarity, class: className = '' } = Astro.props;
---

<div class={`flex items-center gap-0.5 ${className}`} aria-label={`${rarity} star rarity`} title={`${rarity}★`}>
  {
    Array.from({ length: rarity }).map(() => (
      <svg viewBox="0 0 20 20" class="h-3.5 w-3.5 fill-current text-amber-400">
        <path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L1.3 7.8l6.1-.7L10 1.5z" />
      </svg>
    ))
  }
</div>
