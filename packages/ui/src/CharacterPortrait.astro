---
// Character portrait with a graceful placeholder fallback (see public/images/placeholder.svg
// and scripts/fetch-assets.mjs, which populates public/images/characters/{id}.png).
export interface Props {
  id: string;
  name?: string;
  size?: number;
  class?: string;
}

const { id, name, size = 64, class: className = '' } = Astro.props;
---

<img
  src={`/images/characters/${id}.png`}
  onerror="this.onerror=null;this.src='/images/placeholder.svg'"
  alt={name ?? id}
  width={size}
  height={size}
  loading="lazy"
  class={`shrink-0 rounded-lg bg-white/5 object-cover ring-1 ring-inset ring-white/10 ${className}`}
  style={`width:${size}px;height:${size}px;`}
/>
